{
  "name": "@openpanel/root",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Carl-Gerhard Lindesvärd",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.19.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.0",
      "onFail": "warn"
    }
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/**",
      "tooling/*"
    ],
    "catalog": {
      "zod": "4.3.6",
      "react": "19.2.3",
      "@types/react": "19.2.7",
      "react-dom": "19.2.3",
      "@types/react-dom": "19.2.3",
      "@types/node": "24.10.1",
      "typescript": "5.9.3",
      "pino": "10.3.1",
      "pino-pretty": "13.1.3",
      "@hyperdx/node-opentelemetry": "0.10.3"
    }
  },
  "overrides": {
    "rolldown": "1.0.0-beta.43",
    "esm-env": "npm:esm-env-runtime@^0.1.0",
    "seroval": "1.3.2",
    "seroval-plugins": "1.3.2",
    "embla-carousel": "8.0.0-rc22",
    "express": "4.19.2",
    "h3": "1.15.4",
    "nuxt": "4.2.2",
    "react-native": "0.73.6",
    "expo-application": "5.3.1",
    "expo-constants": "15.4.5",
    "lucide-react@^1.7.0": "0.555.0",
    "framer-motion@^12.40.0": "12.40.0",
    "motion-dom@^12.23.23": "12.40.0",
    "vue": "3.5.25"
  },
  "scripts": {
    "test": "bun run --filter @openpanel/core test && bun run --filter @openpanel/db test && bun run --filter @openpanel/api test && bun run --filter start test && vitest run",
    "gen:bots": "bun run --filter @openpanel/core gen:bots",
    "gen:referrers": "bun run --filter @openpanel/core gen:referrers",
    "dock:up": "docker compose up -d",
    "dock:down": "docker compose down",
    "dock:ch": "docker compose exec -it op-ch clickhouse-client -d openpanel",
    "dock:redis": "docker compose exec -it op-kv redis-cli",
    "db:codegen": "bun run --filter @openpanel/db codegen",
    "codegen": "bun run --filter @openpanel/db codegen && bun run --filter @openpanel/core codegen",
    "migrate": "bun run --filter @openpanel/db migrate",
    "migrate:deploy": "bun run --filter @openpanel/db migrate:deploy",
    "postinstall:workspaces": "bun run --filter public postinstall && bun run --filter @openpanel/testbed postinstall",
    "dev": "bun run --filter @openpanel/api testing & bun run --filter start dev & wait",
    "dev:public": "bun run --filter public dev",
    "typecheck": "bun tooling/scripts/typecheck-workspaces.ts",
    "update-simple-git-hooks": "npx simple-git-hooks",
    "check:workspace": "bunx sherif@1.13.0",
    "check:deps": "bun tooling/scripts/check-deps.ts",
    "check": "ultracite check && bun run check:deps",
    "fix": "ultracite fix"
  },
  "simple-git-hooks": {
    "pre-push": "[ -n \"$SKIP_HOOKS\" ] || (bun run typecheck && bun run test)"
  },
  "dependencies": {
    "@hyperdx/node-opentelemetry": "catalog:",
    "dotenv-cli": "7.3.0",
    "semver": "7.6.0",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "depcheck": "1.4.7",
    "simple-git-hooks": "2.12.1",
    "ultracite": "7.2.0",
    "vitest": "3.1.3"
  }
}
