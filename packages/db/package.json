{
  "name": "@openpanel/db",
  "version": "0.0.1",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "codegen": "bun run with-env prisma generate && bun prisma/prisma-json-types.ts",
    "migrate": "bun run with-env prisma migrate dev",
    "studio": "bun run with-env prisma studio --port ${STUDIO_PORT:-5555} --browser none",
    "migrate:deploy:code": "bun run with-env bun ./scripts/migrate-code.ts",
    "migrate:deploy:db": "bun run with-env prisma migrate deploy",
    "migrate:deploy": "bun run migrate:deploy:db && bun run migrate:deploy:code",
    "duplicate-events": "bun run with-env bun ./scripts/find-duplicate-events.ts",
    "test": "bun test --isolate",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env -c --"
  },
  "dependencies": {
    "@clickhouse/client": "1.18.5",
    "@hyperdx/node-opentelemetry": "catalog:",
    "@openpanel/core": "workspace:*",
    "@openpanel/payments": "workspace:*",
    "@openpanel/redis": "workspace:*",
    "@openpanel/shared": "workspace:*",
    "@prisma/client": "6.14.0",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "prisma-json-types-generator": "3.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openpanel/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "bun-types": "1.4.0",
    "prisma": "6.14.0",
    "typescript": "catalog:"
  }
}
