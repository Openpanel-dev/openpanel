{
  "name": "@openpanel/db",
  "version": "0.0.1",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "codegen": "pnpm with-env prisma generate && jiti prisma/prisma-json-types.ts",
    "migrate": "pnpm with-env prisma migrate dev",
    "migrate:deploy:code": "pnpm --filter @openpanel/core run migrate:deploy:code",
    "migrate:deploy:db": "pnpm with-env prisma migrate deploy",
    "migrate:deploy": "pnpm migrate:deploy:db && pnpm migrate:deploy:code",
    "duplicate-events": "pnpm with-env jiti ./scripts/find-duplicate-events.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env -c --"
  },
  "dependencies": {
    "@clickhouse/client": "^1.18.5",
    "@hyperdx/node-opentelemetry": "catalog:",
    "@openpanel/core": "workspace:*",
    "@openpanel/json": "workspace:*",
    "@openpanel/payments": "workspace:*",
    "@openpanel/queue": "workspace:^",
    "@openpanel/redis": "workspace:*",
    "@openpanel/validation": "workspace:*",
    "@prisma/client": "^6.14.0",
    "jiti": "^2.4.1",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "prisma-json-types-generator": "^3.1.1",
    "sqlstring": "^2.3.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openpanel/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/sqlstring": "^2.3.2",
    "prisma": "^6.14.0",
    "typescript": "catalog:"
  }
}
