{
  "name": "@openpanel/core",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./modules/*.constants": "./src/modules/*.constants.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate",
    "codegen": "bun scripts/download-geo.ts && bun scripts/get-datacenter-asns.ts",
    "gen:asns": "bun scripts/get-datacenter-asns.ts",
    "gen:referrers": "bun scripts/get-referrers.ts && biome format --write ./src/shared/referrers/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.974.0",
    "@aws-sdk/client-sts": "^3.974.0",
    "@babel/parser": "^7.26.0",
    "@better-agent/core": "^0.1.0-beta.3",
    "@better-agent/providers": "^0.1.0-beta.3",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "@google-cloud/storage": "^7.18.0",
    "@hyperdx/node-opentelemetry": "catalog:",
    "@maxmind/geoip2-node": "^6.1.0",
    "@openpanel/auth": "workspace:^",
    "@openpanel/common": "workspace:*",
    "@openpanel/validation": "workspace:*",
    "@slack/bolt": "^3.18.0",
    "@slack/oauth": "^3.0.0",
    "@trpc/server": "^11.17.0",
    "bullmq": "6.3.3",
    "elysia": "1.4.30",
    "ipaddr.js": "^2.5.0",
    "lru-cache": "^11.2.4",
    "nanoid": "^5.1.6",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "prom-client": "^15.1.3",
    "superjson": "^1.13.3",
    "ua-parser-js": "^2.0.6",
    "undici": "^8.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openpanel/tsconfig": "workspace:*",
    "bun-types": "1.4.0",
    "tar": "^7.4.3",
    "typescript": "catalog:"
  }
}
