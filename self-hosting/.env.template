NODE_ENV="production"
SELF_HOSTED="true"
BATCH_SIZE="5000"
BATCH_INTERVAL="10000"
ALLOW_REGISTRATION="false"
ALLOW_INVITATION="true"
# Optional: comma-separated OAuth email domains allowed to sign in/sign up.
# OAUTH_ALLOWED_DOMAINS="example.com"
# Will be replaced with the setup script
REDIS_URL="$REDIS_URL"
CLICKHOUSE_URL="$CLICKHOUSE_URL"
DATABASE_URL="$DATABASE_URL"
DATABASE_URL_DIRECT="$DATABASE_URL_DIRECT"
DASHBOARD_URL="$DASHBOARD_URL"
API_URL="$API_URL"
COOKIE_SECRET="$COOKIE_SECRET"
EMAIL_SENDER="$EMAIL_SENDER"
RESEND_API_KEY="$RESEND_API_KEY"
ENCRYPTION_KEY="$ENCRYPTION_KEY"

# Optional: Social login (Google / GitHub)
# Docs: https://openpanel.dev/docs/self-hosting/social-login
# The redirect URIs must match the "Authorized redirect URI" configured at the
# provider exactly. Default layout: <your-domain>/api/oauth/<provider>/callback
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/oauth/google/callback
# GITHUB_CLIENT_ID=Iv1.xxxx
# GITHUB_CLIENT_SECRET=xxxx
# GITHUB_REDIRECT_URI=https://your-domain.com/api/oauth/github/callback

# Optional: Google Search Console integration
# Docs: https://openpanel.dev/docs/self-hosting/google-search-console
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above, plus its own redirect
# URI. Requires ENCRYPTION_KEY (generated by the setup script).
# GSC_GOOGLE_REDIRECT_URI=https://your-domain.com/api/gsc/callback
