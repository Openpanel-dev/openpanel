{
  "name": "@openpanel/testbed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-op1.mjs && vite --port ${TESTBED_PORT:-3100} --strictPort",
    "build": "node scripts/copy-op1.mjs && tsc && vite build",
    "e2e": "playwright test",
    "postinstall": "node scripts/copy-op1.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openpanel/web": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "7.13.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "catalog:",
    "vite": "7.3.0"
  }
}
