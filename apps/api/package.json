{
  "name": "@openpanel/api",
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -c -v WATCH=1 tsdown",
    "testing": "API_PORT=3333 pnpm dev",
    "dev:worker": "ROLE=worker dotenv -e ../../.env -- bun --watch src/main.ts",
    "start": "dotenv -e ../../.env node dist/index.js",
    "build": "rm -rf dist && tsdown",
    "test:manage": "jiti scripts/test-manage-api.ts",
    "e2e:sessions": "LOG_LEVEL=warn dotenv -e ../../.env -- jiti e2e/session-e2e.ts",
    "e2e:sessions:stress": "LOG_LEVEL=warn dotenv -e ../../.env -- jiti e2e/session-stress.ts",
    "e2e:legacy-jobs": "bash e2e/legacy-job-proof.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-agent/adapters": "^0.1.0-beta.3",
    "@better-agent/core": "^0.1.0-beta.3",
    "@fastify/compress": "^8.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/websocket": "^11.2.0",
    "@hyperdx/node-opentelemetry": "catalog:",
    "@node-rs/argon2": "^2.0.2",
    "@openpanel/common": "workspace:*",
    "@openpanel/constants": "workspace:*",
    "@openpanel/core": "workspace:*",
    "@openpanel/db": "workspace:*",
    "@openpanel/json": "workspace:*",
    "@openpanel/payments": "workspace:*",
    "@openpanel/queue": "workspace:*",
    "@openpanel/redis": "workspace:*",
    "@openpanel/trpc": "workspace:*",
    "@openpanel/validation": "workspace:*",
    "@trpc/server": "^11.17.0",
    "fast-json-stable-hash": "^1.0.3",
    "fastify": "^5.8.5",
    "fastify-metrics": "^12.1.0",
    "fastify-raw-body": "^5.0.0",
    "fastify-zod-openapi": "^5.6.1",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "prom-client": "^15.1.3",
    "ramda": "^0.29.1",
    "sharp": "^0.33.5",
    "source-map-support": "^0.5.21",
    "uuid": "^9.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.1",
    "@openpanel/tsconfig": "workspace:*",
    "@types/ramda": "^0.30.2",
    "@types/source-map-support": "^0.5.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "tsdown": "0.14.2",
    "typescript": "catalog:",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.974.0",
    "@aws-sdk/client-sts": "^3.974.0",
    "@google-cloud/storage": "^7.18.0"
  }
}
